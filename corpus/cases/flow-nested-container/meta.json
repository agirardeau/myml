{
  "summary": "Flow containers may contain nested flow containers on one line",
  "tags": [
    "flow",
    "nesting",
    "comments"
  ],
  "spec_refs": [
    "containers.flow-style"
  ],
  "notes": "Nests flow mappings and sequences, including empty ones, within flow containers, and follows one with a comment.",
  "parse_profiles": {
    "baseline": {
      "modes": "all",
      "expect_node_graph": "expected_node_graph.json"
    }
  },
  "emit_profiles": {
    "standard": {
      "mode": "standard",
      "expect_output": "expected_emit_standard.yaml"
    },
    "strict": {
      "mode": "strict",
      "expect_output": "expected_emit_strict.yaml"
    },
    "roundtrip": {
      "mode": "standard",
      "options": {
        "roundtrip": true
      },
      "requires": [
        "roundtrip"
      ],
      "expect_output": "expected_emit_roundtrip.yaml"
    }
  }
}
