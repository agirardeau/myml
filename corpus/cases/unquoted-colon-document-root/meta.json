{
  "summary": "A colon not followed by a space keeps a root scalar a string",
  "tags": [
    "unquoted-string",
    "colon",
    "scalar-only"
  ],
  "spec_refs": [
    "grammar.unquoted-strings",
    "grammar.block-style-mappings"
  ],
  "notes": "A `:` separates a block mapping key from its value only when followed by whitespace, so `a:b` is a string rather than a mapping.",
  "parse_profiles": {
    "standard": {
      "modes": [
        "standard"
      ],
      "expect_node_graph": "expected_node_graph.json"
    },
    "strict": {
      "modes": [
        "strict"
      ],
      "expect_error": {
        "code": "strict-mode-unquoted-string",
        "category": "mode_restriction",
        "line": 1,
        "column": 1
      }
    }
  },
  "emit_profiles": {
    "standard": {
      "mode": "standard",
      "expect_output": "expected_emit_standard.yaml"
    },
    "strict": {
      "mode": "strict",
      "expect_output": "expected_emit_strict.yaml"
    }
  }
}
